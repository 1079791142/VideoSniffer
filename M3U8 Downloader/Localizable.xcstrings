    "addDownloadSupportedLinksDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support master playlists, relative segment paths, byte ranges, and AES-128 encrypted streams. DRM, sign-in-only links, and links that require custom cookies or headers are currently not supported."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持主播放列表、相对分片路径、字节范围和 AES-128 加密流。暂不支持 DRM、需要登录的链接，以及依赖自定义 Cookie 或请求头的链接"
          }
        }
      }
    },
